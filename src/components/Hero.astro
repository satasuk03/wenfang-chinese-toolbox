---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero-inkwash.png';
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      <p class="hero-eyebrow anim-fade-up">
        <span>Free &amp; Open</span>
        <span>·</span>
        <span class="accent">For Learners</span>
      </p>
      <h1 class="hero-headline anim-fade-up">Chinese Learning <em>Toolbox.</em></h1>
      <p class="hero-deck anim-fade-up">
        Practical study tools for Chinese learners —
        <b>flashcards tied to your textbook</b>, stroke-order playback for any
        character you paste in. Free to use, no sign-up required.
      </p>
    </div>
    <figure class="hero-image">
      <div class="hero-image-frame anim-fade-up">
        <Image
          src={heroImage}
          alt="Inkwash brush painting of a young xian-style scholar standing on a misty mountain peak"
          widths={[440, 600, 800, 1200]}
          sizes="(max-width: 560px) 90vw, (max-width: 880px) 440px, (max-width: 1080px) 460px, 540px"
          format="avif"
          loading="eager"
          class="hero-img"
        />
      </div>
      <figcaption class="hero-image-caption anim-fade-up">
        <span>Plate I.</span>
        <span>Mountain · Inkwash · 2026</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 96px 0 120px;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 72px;
    align-items: end;
  }
  .hero-text {
    padding-bottom: 18px;
    max-width: 640px;
  }
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 36px;
  }
  .hero-eyebrow::before {
    content: '';
    width: 38px;
    height: 1px;
    background: var(--color-accent);
    display: inline-block;
  }
  .hero-eyebrow .accent {
    color: var(--color-accent);
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(48px, 6.6vw, 104px);
    line-height: 0.96;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    text-wrap: balance;
    margin-bottom: 36px;
    font-weight: 400;
  }
  .hero-headline em {
    font-style: italic;
    color: var(--color-accent);
  }

  .hero-deck {
    font-size: 19px;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 42ch;
    margin-bottom: 48px;
    text-wrap: pretty;
  }
  .hero-deck b {
    color: var(--color-fg);
    font-weight: 500;
  }

  .hero-image {
    position: relative;
    align-self: end;
  }
  .hero-image-frame {
    position: relative;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    overflow: hidden;
    aspect-ratio: 2 / 3;
  }
  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hero-image-frame:hover .hero-img {
    transform: scale(1.03);
  }
  .hero-image-caption {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
    display: flex;
    justify-content: space-between;
  }

  /* Entrance animations */
  .anim-fade-up {
    opacity: 0;
    animation: fade-up 0.85s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero-eyebrow.anim-fade-up {
    animation-delay: 0.05s;
  }
  .hero-headline.anim-fade-up {
    animation-delay: 0.15s;
  }
  .hero-deck.anim-fade-up {
    animation-delay: 0.3s;
  }
  .hero-image-frame.anim-fade-up {
    animation-delay: 0.25s;
    animation-duration: 1s;
  }
  .hero-image-caption.anim-fade-up {
    animation-delay: 0.5s;
  }

  /* Subtle image hover zoom */
  .hero-image-frame {
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hero-image-frame:hover {
    transform: scale(1.01);
  }

  @media (max-width: 1080px) {
    .hero {
      padding: 72px 0 96px;
    }
    .hero-inner {
      gap: 48px;
    }
  }
  @media (max-width: 880px) {
    .hero {
      padding: 56px 0 72px;
    }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .hero-image {
      order: -1;
      max-width: 440px;
    }
    .hero-text {
      padding-bottom: 0;
    }
  }
  @media (max-width: 560px) {
    .hero-eyebrow {
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 24px;
    }
    .hero-eyebrow::before {
      width: 24px;
    }
    .hero-headline {
      margin-bottom: 24px;
    }
    .hero-deck {
      font-size: 17px;
      margin-bottom: 32px;
    }
    .hero-meta {
      grid-template-columns: 1fr 1fr;
      row-gap: 16px;
      max-width: none;
    }
  }
</style>
