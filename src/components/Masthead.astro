<header class="masthead" id="top" data-menu-open="false">
  <div class="container masthead-inner">
    <a href="/" class="wordmark" aria-label="Wénfáng — home">
      <span class="wordmark-cn">文房</span>
      <span class="wordmark-en">Wén<em>fáng</em></span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="#top" class="dot">Home</a>
      <a href="/tools/flashcards/">Flashcards</a>
      <a href="/tools/stroke-order/">Stroke Order</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>
    <button
      class="nav-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="bar" aria-hidden="true"></span>
      <span class="bar" aria-hidden="true"></span>
      <span class="bar" aria-hidden="true"></span>
    </button>
  </div>
  <div class="header-meta">
    <div class="container header-meta-inner">
      <span>Free &amp; open</span>
      <div class="right">
        <span>Made by Zeze</span>
      </div>
    </div>
  </div>
  <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile" hidden>
    <div class="container mobile-menu-inner">
      <a href="#top" class="dot">Home</a>
      <a href="/tools/flashcards/">Flashcards</a>
      <a href="/tools/stroke-order/">Stroke Order</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
      <div class="mobile-menu-foot">
        <span>Free &amp; open</span>
        <span>Made by Zeze</span>
      </div>
    </div>
  </nav>
</header>

<script>
  const masthead = document.querySelector<HTMLElement>('.masthead');
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');

  if (masthead && toggle && menu) {
    const setOpen = (open: boolean) => {
      masthead.dataset.menuOpen = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open) {
        menu.removeAttribute('hidden');
      } else {
        // delay so the slide-up transition can run before hiding
        setTimeout(() => {
          if (masthead.dataset.menuOpen === 'false') menu.setAttribute('hidden', '');
        }, 220);
      }
      document.body.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => {
      setOpen(masthead.dataset.menuOpen !== 'true');
    });

    menu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && masthead.dataset.menuOpen === 'true') setOpen(false);
    });

    // Close menu if viewport grows past mobile breakpoint
    const mq = window.matchMedia('(min-width: 561px)');
    mq.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<style>
  .masthead {
    border-bottom: 1px solid var(--color-border);
    position: relative;
    z-index: 10;
    background: var(--color-bg);
  }
  .masthead-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 22px;
  }
  .wordmark {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .wordmark-cn {
    font-family: var(--font-zh);
    font-size: 28px;
    color: var(--color-ink);
    letter-spacing: 0.04em;
    line-height: 1;
  }
  .wordmark-en {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding-left: 14px;
    border-left: 1px solid var(--color-border);
  }
  .wordmark-en em {
    font-style: italic;
    color: var(--color-fg);
  }

  .nav {
    display: flex;
    gap: 36px;
    align-items: center;
  }
  .nav a {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-fg);
    transition: color 0.15s ease;
  }
  .nav a:hover {
    color: var(--color-accent);
  }
  .nav a.dot::before,
  .mobile-menu a.dot::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    margin-right: 8px;
    vertical-align: middle;
    transform: translateY(-1px);
  }

  .header-meta {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding: 9px 0;
  }
  .header-meta-inner {
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }

  /* Hamburger button — hidden by default, visible < 560px */
  .nav-toggle {
    display: none;
    width: 36px;
    height: 36px;
    padding: 8px;
    background: transparent;
    border: 1px solid var(--color-border);
    cursor: pointer;
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
    transition: border-color 0.15s ease;
  }
  .nav-toggle:hover {
    border-color: var(--color-ink);
  }
  .nav-toggle .bar {
    display: block;
    height: 1.5px;
    width: 100%;
    background: var(--color-ink);
    transition:
      transform 0.2s ease,
      opacity 0.15s ease;
    transform-origin: center;
  }

  /* Hamburger morphs to X when open */
  [data-menu-open='true'] .nav-toggle .bar:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }
  [data-menu-open='true'] .nav-toggle .bar:nth-child(2) {
    opacity: 0;
  }
  [data-menu-open='true'] .nav-toggle .bar:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }

  /* Mobile menu panel — slides in from top, sits below the masthead row */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    transform: translateY(-8px);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }
  [data-menu-open='true'] .mobile-menu {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    padding-block: 24px 28px;
    gap: 24px;
  }
  .mobile-menu a {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-fg);
    padding: 4px 0;
    transition: color 0.15s ease;
  }
  .mobile-menu a:hover {
    color: var(--color-accent);
  }
  .mobile-menu-foot {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 8px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (max-width: 560px) {
    .nav {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
    .header-meta {
      display: none;
    }
  }
</style>
