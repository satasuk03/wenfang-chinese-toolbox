---
const tools = [
  {
    href: '/tools/flashcards/',
    number: '01',
    name: 'Flashcards',
    cn: '生词卡',
    deck: 'Vocabulary cards bound to the exact word lists in Hanyu Jiaocheng. Pick a book, pick chapters, choose what you see first.',
    status: 'live',
  },
  {
    href: '/tools/hsk-flashcard/',
    number: '02',
    name: 'HSK Flashcards',
    cn: 'HSK 生词卡',
    deck: 'HSK vocabulary flashcards with Thai translations. Select Level 1 or Level 2, choose what you see first, and flip to reveal.',
    status: 'live',
  },
  {
    href: '/tools/stroke-order/',
    number: '03',
    name: 'Stroke order',
    cn: '笔顺',
    deck: 'Paste any Chinese character. See the full stroke-order diagram, then watch an animated playback or step through stroke by stroke.',
    status: 'live',
  },
  {
    href: '/tools/handwriting/',
    number: '04',
    name: 'Handwriting',
    cn: '写字',
    deck: 'Look at pinyin or meaning, then write the character stroke by stroke. Hints and auto-reveal when you need help.',
    status: 'live',
  },
];
---

<section class="tools" id="tools">
  <div class="container">
    <header class="tools-rule">
      <h2 class="tools-title"><b>Tools</b><em>The Studio · 文房</em></h2>
      <span class="tools-count">{tools.length} instruments</span>
    </header>
    <div class="tool-grid">
      {
        tools.map((tool, i) => {
          const Wrapper = tool.href ? 'a' : 'div';
          const wrapperProps = tool.href ? { href: tool.href } : {};
          return (
            <Wrapper class={`tool anim-fade-up tool-delay-${i}`} {...wrapperProps}>
              <div class="tool-head">
                <span class="tool-number">— {tool.number}</span>
                <h3 class="tool-name">
                  {tool.name}
                  <span class="cn">{tool.cn}</span>
                </h3>
              </div>
              <p class="tool-deck">{tool.deck}</p>
              <div class="tool-foot">
                <span class={`status status-${tool.status}`}>
                  {tool.status === 'live' ? 'Live' : 'Coming soon'}
                </span>
                {tool.href && <span class="open">Open →</span>}
              </div>
            </Wrapper>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .tools {
    padding: 120px 0 80px;
  }
  .tools-rule {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1.5px solid var(--color-ink);
    padding-bottom: 14px;
  }
  .tools-title {
    font-family: var(--font-display);
    font-size: 14px;
    font-style: italic;
    color: var(--color-ink);
    letter-spacing: 0;
    font-weight: 400;
  }
  .tools-title b {
    font-style: normal;
    font-weight: 500;
    margin-right: 6px;
  }
  .tools-title em {
    color: var(--color-muted);
    margin-left: 8px;
  }
  .tools-count {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .tool-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .tool {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding: 56px 48px 44px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    color: inherit;
    transition:
      background 0.25s ease,
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  a.tool:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px oklch(14% 0.02 60 / 0.04);
  }
  .tool:nth-child(2n) {
    border-right: 0;
  }
  a.tool:hover {
    background: var(--color-paper);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px oklch(14% 0.02 60 / 0.04);
  }
  div.tool {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .tool-head {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .tool-number {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .tool-name {
    font-family: var(--font-display);
    font-size: clamp(30px, 3vw, 42px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    font-weight: 400;
    text-wrap: balance;
  }
  .tool-name .cn {
    display: block;
    font-family: var(--font-zh);
    font-size: 0.5em;
    color: var(--color-muted);
    margin-top: 10px;
    letter-spacing: 0.06em;
  }
  .tool-deck {
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-muted);
    max-width: 46ch;
    text-wrap: pretty;
    flex: 1;
  }
  .tool-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-border);
    padding-top: 20px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .status {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .status-live {
    color: var(--color-accent);
  }
  .status-live::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: pulse 2.4s ease-in-out infinite;
  }
  .status-soon::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-muted);
    opacity: 0.4;
  }

  /* Entrance animations */
  .tool.anim-fade-up {
    opacity: 0;
    animation: fade-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .tool-delay-0.anim-fade-up {
    animation-delay: 0s;
  }
  .tool-delay-1.anim-fade-up {
    animation-delay: 0.12s;
  }
  .tool-delay-2.anim-fade-up {
    animation-delay: 0.24s;
  }

  @media (max-width: 880px) {
    .tools {
      padding: 80px 0 56px;
    }
    .tool-grid {
      grid-template-columns: 1fr;
    }
    .tool {
      border-right: 0;
      padding: 44px 32px 36px;
    }
  }
  @media (max-width: 560px) {
    .tool {
      padding: 36px 24px 28px;
      gap: 28px;
    }
  }
</style>
