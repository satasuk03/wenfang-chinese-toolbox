---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Masthead from '../../../components/Masthead.astro';
import Footer from '../../../components/Footer.astro';

const examples = ['你好', '学海无涯', '今天', '中国'];
---

<BaseLayout title="Stroke order · Wénfáng">
  <Masthead />
  <main id="main">
    <section class="stroke">
      <div class="container">
        <header class="stroke-header">
          <h1>Stroke order</h1>
          <p class="stroke-deck">Paste Chinese characters to see their stroke order. Click Animate to watch them draw.</p>
        </header>

        <form class="stroke-form" id="stroke-form" autocomplete="off">
          <input
            type="text"
            id="stroke-input"
            class="stroke-input"
            placeholder="学海无涯"
            spellcheck="false"
            autocapitalize="off"
            maxlength="120"
          />
          <button type="submit" class="stroke-go">Show</button>
        </form>

        <div class="stroke-examples">
          {examples.map((ex) => (
            <button type="button" class="stroke-example" data-example={ex}>
              {ex}
            </button>
          ))}
        </div>

        <div class="stroke-results" id="stroke-results"></div>

        <p class="stroke-empty" id="stroke-empty">Type characters above to see stroke order.</p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script src="/hanzi-writer.min.js" is:inline></script>

<script is:inline>
  const form = document.getElementById('stroke-form');
  const input = document.getElementById('stroke-input');
  const results = document.getElementById('stroke-results');
  const emptyState = document.getElementById('stroke-empty');

  const isHan = (cp) =>
    (cp >= 0x3400 && cp <= 0x4dbf) ||
    (cp >= 0x4e00 && cp <= 0x9fff) ||
    (cp >= 0x20000 && cp <= 0x2a6df) ||
    (cp >= 0x2a700 && cp <= 0x2b73f) ||
    (cp >= 0x2b740 && cp <= 0x2b81f) ||
    (cp >= 0x2b820 && cp <= 0x2ceaf);

  const splitChars = (text) => {
    const out = [];
    for (const ch of text) {
      const cp = ch.codePointAt(0);
      if (cp != null && isHan(cp)) out.push({ ch, cp });
    }
    return out;
  };

  const writerStates = new Map();

  const showImage = (index) => {
    const card = results.querySelector(`.stroke-card[data-index="${index}"]`);
    if (!card) return;
    const img = card.querySelector('img');
    const fallback = card.querySelector('.stroke-fallback');
    const writerDiv = card.querySelector('.stroke-writer');

    img.style.display = '';
    fallback.style.display = '';
    writerDiv.style.display = 'none';
    writerDiv.innerHTML = '';

    const char = card.dataset.char;
    const actions = card.querySelector('.stroke-actions');
    actions.innerHTML = `<button type="button" class="stroke-btn" data-action="start" data-index="${index}" data-char="${char}">Animate</button>`;

    writerStates.delete(index);
  };

  const startAnimation = (index, char) => {
    const card = results.querySelector(`.stroke-card[data-index="${index}"]`);
    if (!card) return;

    const img = card.querySelector('img');
    const fallback = card.querySelector('.stroke-fallback');
    const writerDiv = card.querySelector('.stroke-writer');
    const actions = card.querySelector('.stroke-actions');

    img.style.display = 'none';
    fallback.style.display = 'none';
    writerDiv.style.display = 'flex';

    const writer = HanziWriter.create(writerDiv, char, {
      width: 300,
      height: 300,
      padding: 20,
      strokeColor: '#2a2622',
      outlineColor: '#d4cfc8',
      showCharacter: false,
      showOutline: true,
      charDataLoader: (ch, onLoad, onError) => {
        fetch(`/hanzi-data/${encodeURIComponent(ch)}.json`)
          .then((res) => {
            if (!res.ok) throw new Error('Not found');
            return res.json();
          })
          .then(onLoad)
          .catch(onError);
      },
      onLoadCharDataError: () => {
        writerDiv.innerHTML = '<span class="stroke-writer-error">Not available</span>';
      },
    });

    const state = { writer, char, currentStroke: 0, totalStrokes: null };
    writerStates.set(index, state);

    fetch(`/hanzi-data/${encodeURIComponent(char)}.json`)
      .then((res) => {
        if (!res.ok) throw new Error('Not found');
        return res.json();
      })
      .then((data) => {
        const s = writerStates.get(index);
        if (s && data && data.strokes) s.totalStrokes = data.strokes.length;
      })
      .catch(() => {});

    actions.innerHTML = `
      <button type="button" class="stroke-btn" data-action="play" data-index="${index}">▶ Play</button>
      <button type="button" class="stroke-btn" data-action="step" data-index="${index}">+ Step</button>
      <button type="button" class="stroke-btn" data-action="image" data-index="${index}">Image</button>
    `;
  };

  const playAnimation = (index) => {
    const state = writerStates.get(index);
    if (!state) return;
    state.currentStroke = 0;
    state.writer.animateCharacter();
  };

  const stepAnimation = (index) => {
    const state = writerStates.get(index);
    if (!state) return;
    if (state.totalStrokes != null && state.currentStroke >= state.totalStrokes) return;
    state.writer
      .animateStroke(state.currentStroke)
      .then(() => {
        state.currentStroke++;
      })
      .catch(() => {});
  };

  results.addEventListener('click', (e) => {
    const btn = e.target.closest('.stroke-btn');
    if (!btn) return;
    const action = btn.dataset.action;
    const index = Number(btn.dataset.index);
    const char = btn.dataset.char;

    if (action === 'start') startAnimation(index, char);
    else if (action === 'play') playAnimation(index);
    else if (action === 'step') stepAnimation(index);
    else if (action === 'image') showImage(index);
  });

  const render = (chars) => {
    writerStates.clear();
    if (chars.length === 0) {
      results.innerHTML = '';
      emptyState.style.display = 'block';
      return;
    }
    emptyState.style.display = 'none';
    results.innerHTML = chars
      .map(({ ch, cp }, i) => {
        const url = `https://www.strokeorder.com/assets/bishun/stroke/${cp}.png`;
        return `
          <figure class="stroke-card" data-status="loading" data-char="${ch}" data-index="${i}">
            <div class="stroke-card-canvas">
              <img
                src="${url}"
                alt="Stroke order for ${ch}"
                loading="lazy"
                onload="this.closest('.stroke-card').dataset.status='ok'"
                onerror="this.closest('.stroke-card').dataset.status='missing'"
              />
              <span class="stroke-fallback">${ch}</span>
              <span class="stroke-missing">Not found</span>
              <div class="stroke-writer"></div>
            </div>
            <figcaption class="stroke-card-label">${ch}</figcaption>
            <div class="stroke-actions">
              <button type="button" class="stroke-btn" data-action="start" data-index="${i}" data-char="${ch}">Animate</button>
            </div>
          </figure>
        `;
      })
      .join('');
  };

  const submit = () => {
    render(splitChars(input.value));
  };

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    submit();
  });

  document.querySelectorAll('.stroke-example').forEach((btn) => {
    btn.addEventListener('click', () => {
      input.value = btn.dataset.example || '';
      input.focus();
      submit();
    });
  });
</script>

<style>
  .stroke {
    padding: 64px 0 100px;
  }
  .stroke-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .stroke-header h1 {
    font-family: var(--font-display);
    font-size: clamp(36px, 4vw, 56px);
    font-weight: 400;
    color: var(--color-ink);
    margin-bottom: 8px;
  }
  .stroke-deck {
    font-size: 16px;
    color: var(--color-muted);
  }

  .stroke-form {
    display: flex;
    gap: 12px;
    max-width: 520px;
    margin: 0 auto 16px;
  }
  .stroke-input {
    flex: 1;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 14px 18px;
    font-family: var(--font-zh);
    font-size: 22px;
    color: var(--color-ink);
    letter-spacing: 0.04em;
    transition: border-color 0.15s ease;
    min-width: 0;
  }
  .stroke-input::placeholder {
    color: var(--color-soft);
  }
  .stroke-input:focus {
    outline: none;
    border-color: var(--color-ink);
  }
  .stroke-go {
    background: var(--color-accent);
    color: var(--color-bg);
    border: 0;
    padding: 0 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.15s ease;
    min-height: 52px;
  }
  .stroke-go:hover {
    background: var(--color-accent-deep);
  }

  .stroke-examples {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 48px;
  }
  .stroke-example {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 8px 14px;
    font-family: var(--font-zh);
    font-size: 16px;
    color: var(--color-ink);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .stroke-example:hover {
    border-color: var(--color-ink);
  }

  .stroke-empty {
    text-align: center;
    font-size: 16px;
    color: var(--color-muted);
    padding: 48px 0;
    border-top: 1px solid var(--color-border);
    margin-top: 16px;
  }

  .stroke-results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 16px;
  }
  .stroke-results:empty {
    display: none;
  }

  .stroke-card {
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: border-color 0.15s ease;
  }
  .stroke-card:hover {
    border-color: var(--color-ink);
  }
  .stroke-card-canvas {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }
  .stroke-card-canvas img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.2s ease;
  }
  .stroke-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-zh);
    font-size: 80px;
    color: var(--color-soft);
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.2s ease;
  }
  .stroke-missing {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .stroke-card[data-status='loading'] img {
    opacity: 0;
  }
  .stroke-card[data-status='ok'] img {
    opacity: 1;
  }
  .stroke-card[data-status='ok'] .stroke-fallback {
    opacity: 0;
  }
  .stroke-card[data-status='missing'] img {
    display: none;
  }
  .stroke-card[data-status='missing'] .stroke-fallback {
    display: none;
  }
  .stroke-card[data-status='missing'] .stroke-missing {
    display: flex;
  }

  .stroke-card-label {
    text-align: center;
    font-family: var(--font-zh);
    font-size: 20px;
    color: var(--color-ink);
    padding-top: 4px;
  }

  .stroke-actions {
    display: flex;
    gap: 6px;
    justify-content: center;
    padding-top: 8px;
    border-top: 1px solid var(--color-border);
  }
  .stroke-btn {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 6px 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
    flex: 1;
  }
  .stroke-btn:hover {
    border-color: var(--color-ink);
    background: var(--color-paper);
  }

  .stroke-writer {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: var(--color-bg);
  }
  .stroke-writer svg {
    width: 100%;
    height: 100%;
  }
  .stroke-writer-error {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (max-width: 560px) {
    .stroke {
      padding: 40px 0 64px;
    }
    .stroke-form {
      flex-direction: column;
    }
    .stroke-go {
      width: 100%;
      padding: 14px;
      min-height: 48px;
    }
    .stroke-results {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .stroke-card {
      padding: 10px;
    }
    .stroke-fallback {
      font-size: 56px;
    }
  }
</style>
