---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Masthead from '../../../components/Masthead.astro';
import Footer from '../../../components/Footer.astro';

const examples = ['你好', '学海无涯', '今天', '中国'];
---

<BaseLayout title="Stroke order · Wénfáng">
  <Masthead />
  <main id="main">
    <section class="stroke">
      <div class="container">
        <header class="stroke-header">
          <h1>Stroke order</h1>
          <p class="stroke-deck">Paste Chinese characters to see their stroke order.</p>
        </header>

        <form class="stroke-form" id="stroke-form" autocomplete="off">
          <input
            type="text"
            id="stroke-input"
            class="stroke-input"
            placeholder="学海无涯"
            spellcheck="false"
            autocapitalize="off"
            maxlength="120"
          />
          <button type="submit" class="stroke-go">Show</button>
        </form>

        <div class="stroke-examples">
          {examples.map((ex) => (
            <button type="button" class="stroke-example" data-example={ex}>
              {ex}
            </button>
          ))}
        </div>

        <div class="stroke-stage" id="stroke-stage">
          <div class="stroke-scene">
            <div class="stroke-canvas-wrap" id="canvas-wrap">
              <div class="stroke-canvas" id="stroke-canvas"></div>
              <img class="stroke-steps-img" id="stroke-steps-img" alt="" loading="lazy" />
              <span class="stroke-canvas-fallback" id="canvas-fallback"></span>
              <span class="stroke-canvas-error" id="canvas-error">Not available</span>
            </div>

            <div class="stroke-tabs" id="stroke-tabs">
              <button type="button" class="stroke-tab is-active" data-tab="character">Character</button>
              <button type="button" class="stroke-tab" data-tab="animate">Animate</button>
              <button type="button" class="stroke-tab" data-tab="steps">All Steps</button>
            </div>

            <div class="stroke-animate-controls" id="animate-controls">
              <button type="button" class="ctrl-btn" id="btn-play">▶ Play</button>
              <button type="button" class="ctrl-btn" id="btn-step">+ Step</button>
              <button type="button" class="ctrl-btn" id="btn-reset">Reset</button>
            </div>
          </div>

          <div class="stroke-meta">
            <span class="stroke-char-label" id="char-label"></span>
            <div class="stroke-nav">
              <button type="button" class="nav-btn" id="btn-prev">← Prev</button>
              <span class="stroke-counter" id="stroke-counter">—</span>
              <button type="button" class="nav-btn" id="btn-next">Next →</button>
            </div>
          </div>

          <div class="stroke-chars" id="stroke-chars"></div>
        </div>

        <p class="stroke-empty" id="stroke-empty">Type characters above to see stroke order.</p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script src="/hanzi-writer.min.js" is:inline></script>

<script is:inline>
  const form = document.getElementById('stroke-form');
  const input = document.getElementById('stroke-input');
  const stage = document.getElementById('stroke-stage');
  const emptyState = document.getElementById('stroke-empty');
  const canvas = document.getElementById('stroke-canvas');
  const stepsImg = document.getElementById('stroke-steps-img');
  const canvasFallback = document.getElementById('canvas-fallback');
  const canvasError = document.getElementById('canvas-error');
  const charLabel = document.getElementById('char-label');
  const counterEl = document.getElementById('stroke-counter');
  const tabsContainer = document.getElementById('stroke-tabs');
  const animateControls = document.getElementById('animate-controls');
  const charsStrip = document.getElementById('stroke-chars');

  const isHan = (cp) =>
    (cp >= 0x3400 && cp <= 0x4dbf) ||
    (cp >= 0x4e00 && cp <= 0x9fff) ||
    (cp >= 0x20000 && cp <= 0x2a6df) ||
    (cp >= 0x2a700 && cp <= 0x2b73f) ||
    (cp >= 0x2b740 && cp <= 0x2b81f) ||
    (cp >= 0x2b820 && cp <= 0x2ceaf);

  const splitChars = (text) => {
    const out = [];
    for (const ch of text) {
      const cp = ch.codePointAt(0);
      if (cp != null && isHan(cp)) out.push({ ch, cp });
    }
    return out;
  };

  let chars = [];
  let idx = 0;
  let activeTab = 'character';
  let writer = null;
  let currentStroke = 0;
  let totalStrokes = null;
  const charDataLoader = (ch, onLoad, onError) => {
    fetch(`/hanzi-data/${encodeURIComponent(ch)}.json`)
      .then((res) => {
        if (!res.ok) throw new Error('Not found');
        return res.json();
      })
      .then(onLoad)
      .catch(onError);
  };

  const clearWriter = () => {
    if (writer) {
      try {
        writer.cancelQuiz();
      } catch {
        /* ignore */
      }
      writer = null;
    }
    canvas.innerHTML = '';
  };

  const setView = (view, opts = {}) => {
    const { autoplay = false } = opts;
    activeTab = view;

    tabsContainer.querySelectorAll('.stroke-tab').forEach((btn) => {
      btn.classList.toggle('is-active', btn.dataset.tab === view);
    });

    const char = chars[idx]?.ch;
    if (!char) return;

    if (view === 'character') {
      animateControls.style.display = 'none';
      stepsImg.style.display = 'none';
      canvas.style.display = 'flex';
      canvasFallback.style.display = 'none';
      canvasError.style.display = 'none';
      clearWriter();
      writer = HanziWriter.create(canvas, char, {
        width: 320,
        height: 320,
        padding: 20,
        strokeColor: '#2a2622',
        outlineColor: '#d4cfc8',
        showCharacter: true,
        showOutline: true,
        charDataLoader,
        onLoadCharDataError: () => {
          canvas.innerHTML = '';
          canvasError.style.display = 'flex';
        },
      });
      fetch(`/hanzi-data/${encodeURIComponent(char)}.json`)
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => {
          if (d && d.strokes) totalStrokes = d.strokes.length;
        })
        .catch(() => {});
    } else if (view === 'animate') {
      animateControls.style.display = 'flex';
      stepsImg.style.display = 'none';
      canvas.style.display = 'flex';
      canvasFallback.style.display = 'none';
      canvasError.style.display = 'none';
      currentStroke = 0;
      clearWriter();
      writer = HanziWriter.create(canvas, char, {
        width: 320,
        height: 320,
        padding: 20,
        strokeColor: '#2a2622',
        outlineColor: '#d4cfc8',
        showCharacter: false,
        showOutline: true,
        charDataLoader,
        onLoadCharDataSuccess: () => {
          if (autoplay && writer && activeTab === 'animate') {
            writer.animateCharacter();
          }
        },
        onLoadCharDataError: () => {
          canvas.innerHTML = '';
          canvasError.style.display = 'flex';
        },
      });
      fetch(`/hanzi-data/${encodeURIComponent(char)}.json`)
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => {
          if (d && d.strokes) totalStrokes = d.strokes.length;
        })
        .catch(() => {});
    } else if (view === 'steps') {
      animateControls.style.display = 'none';
      clearWriter();
      canvas.style.display = 'none';
      canvasError.style.display = 'none';
      canvasFallback.style.display = 'none';
      const { cp, ch } = chars[idx];
      stepsImg.src = `https://www.strokeorder.com/assets/bishun/stroke/${cp}.png`;
      stepsImg.alt = `Stroke order for ${ch}`;
      stepsImg.style.display = 'block';
      stepsImg.onload = () => {
        canvasFallback.style.display = 'none';
      };
      stepsImg.onerror = () => {
        stepsImg.style.display = 'none';
        canvasFallback.textContent = ch;
        canvasFallback.style.display = 'flex';
      };
    }
  };

  const go = (delta) => {
    if (chars.length === 0) return;
    idx = (idx + delta + chars.length) % chars.length;
    showCharacter();
  };

  const showCharacter = () => {
    if (chars.length === 0) {
      stage.style.display = 'none';
      emptyState.style.display = 'block';
      return;
    }
    stage.style.display = 'block';
    emptyState.style.display = 'none';

    const { ch } = chars[idx];
    charLabel.textContent = ch;
    counterEl.textContent = `${idx + 1} / ${chars.length}`;

    // Update strip
    charsStrip.innerHTML = chars
      .map(
        ({ ch: c }, i) =>
          `<button type="button" class="char-pill${i === idx ? ' is-active' : ''}" data-index="${i}">${c}</button>`,
      )
      .join('');

    setView(activeTab);
  };

  // Tabs
  tabsContainer.addEventListener('click', (e) => {
    const btn = e.target.closest('.stroke-tab');
    if (!btn) return;
    const isMobile = window.matchMedia('(max-width: 560px)').matches;
    setView(btn.dataset.tab, { autoplay: btn.dataset.tab === 'animate' && isMobile });
  });

  // Animation controls
  document.getElementById('btn-play').addEventListener('click', () => {
    if (!writer || activeTab !== 'animate') return;
    currentStroke = 0;
    writer.animateCharacter();
  });

  document.getElementById('btn-step').addEventListener('click', () => {
    if (!writer || activeTab !== 'animate') return;
    if (totalStrokes != null && currentStroke >= totalStrokes) return;
    writer
      .animateStroke(currentStroke)
      .then(() => {
        currentStroke++;
      })
      .catch(() => {});
  });

  document.getElementById('btn-reset').addEventListener('click', () => {
    if (activeTab === 'animate') {
      setView('animate');
    }
  });

  // Navigation
  document.getElementById('btn-prev').addEventListener('click', () => go(-1));
  document.getElementById('btn-next').addEventListener('click', () => go(1));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') go(1);
    if (e.key === 'ArrowLeft') go(-1);
  });

  // Char strip
  charsStrip.addEventListener('click', (e) => {
    const btn = e.target.closest('.char-pill');
    if (!btn) return;
    idx = Number(btn.dataset.index);
    showCharacter();
  });

  // Submit
  const submit = () => {
    chars = splitChars(input.value);
    idx = 0;
    activeTab = 'character';
    showCharacter();
  };

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    submit();
  });

  document.querySelectorAll('.stroke-example').forEach((btn) => {
    btn.addEventListener('click', () => {
      input.value = btn.dataset.example || '';
      input.focus();
      submit();
    });
  });
</script>

<style>
  .stroke {
    padding: 64px 0 100px;
  }
  .stroke-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .stroke-header h1 {
    font-family: var(--font-display);
    font-size: clamp(36px, 4vw, 56px);
    font-weight: 400;
    color: var(--color-ink);
    margin-bottom: 8px;
  }
  .stroke-deck {
    font-size: 16px;
    color: var(--color-muted);
  }

  .stroke-form {
    display: flex;
    gap: 12px;
    max-width: 520px;
    margin: 0 auto 16px;
  }
  .stroke-input {
    flex: 1;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 14px 18px;
    font-family: var(--font-zh);
    font-size: 22px;
    color: var(--color-ink);
    letter-spacing: 0.04em;
    transition: border-color 0.15s ease;
    min-width: 0;
  }
  .stroke-input::placeholder {
    color: var(--color-soft);
  }
  .stroke-input:focus {
    outline: none;
    border-color: var(--color-ink);
  }
  .stroke-go {
    background: var(--color-accent);
    color: var(--color-bg);
    border: 0;
    padding: 0 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.15s ease;
    min-height: 52px;
  }
  .stroke-go:hover {
    background: var(--color-accent-deep);
  }

  .stroke-examples {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 40px;
  }
  .stroke-example {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 8px 14px;
    font-family: var(--font-zh);
    font-size: 16px;
    color: var(--color-ink);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .stroke-example:hover {
    border-color: var(--color-ink);
  }

  .stroke-empty {
    text-align: center;
    font-size: 16px;
    color: var(--color-muted);
    padding: 48px 0;
    border-top: 1px solid var(--color-border);
    margin-top: 16px;
  }

  /* Stage */
  .stroke-stage {
    display: none;
  }

  .stroke-scene {
    width: 100%;
    max-width: 420px;
    margin: 0 auto 20px;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    padding: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .stroke-canvas-wrap {
    position: relative;
    width: 320px;
    height: 320px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }
  .stroke-canvas {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
  }
  .stroke-canvas :global(svg) {
    width: 100%;
    height: 100%;
  }
  .stroke-steps-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: none;
  }
  .stroke-canvas-fallback {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    font-family: var(--font-zh);
    font-size: 120px;
    color: var(--color-soft);
    pointer-events: none;
  }
  .stroke-canvas-error {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* Tabs */
  .stroke-tabs {
    display: flex;
    justify-content: center;
    gap: 0;
    width: 100%;
  }
  .stroke-tab {
    flex: 1;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 10px 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
    cursor: pointer;
    transition:
      color 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
    min-height: 40px;
  }
  .stroke-tab + .stroke-tab {
    border-left: 0;
  }
  .stroke-tab:hover {
    color: var(--color-ink);
  }
  .stroke-tab.is-active {
    background: var(--color-ink);
    color: var(--color-bg);
    border-color: var(--color-ink);
  }

  /* Animate controls */
  .stroke-animate-controls {
    display: none;
    justify-content: center;
    gap: 10px;
    width: 100%;
  }
  .ctrl-btn {
    flex: 1;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 8px 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
    min-height: 36px;
  }
  .ctrl-btn:hover {
    border-color: var(--color-ink);
    background: var(--color-paper);
  }

  /* Meta */
  .stroke-meta {
    text-align: center;
    margin-bottom: 16px;
  }
  .stroke-char-label {
    display: block;
    font-family: var(--font-zh);
    font-size: 28px;
    color: var(--color-ink);
    margin-bottom: 12px;
  }
  .stroke-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
  }
  .nav-btn {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 8px 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .nav-btn:hover {
    border-color: var(--color-ink);
  }
  .nav-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .stroke-counter {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
    min-width: 60px;
    text-align: center;
  }

  /* Char strip */
  .stroke-chars {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    max-width: 520px;
    margin: 0 auto;
  }
  .char-pill {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 6px 14px;
    font-family: var(--font-zh);
    font-size: 18px;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background 0.15s ease,
      color 0.15s ease;
  }
  .char-pill:hover {
    border-color: var(--color-ink);
  }
  .char-pill.is-active {
    background: var(--color-ink);
    color: var(--color-bg);
    border-color: var(--color-ink);
  }

  @media (max-width: 560px) {
    .stroke {
      padding: 40px 0 64px;
    }
    .stroke-form {
      flex-direction: column;
    }
    .stroke-go {
      width: 100%;
      padding: 14px;
      min-height: 48px;
    }
    .stroke-scene {
      padding: 20px;
      max-width: 100%;
    }
    .stroke-canvas-wrap {
      width: 320px;
      height: 320px;
    }
    .stroke-canvas :global(svg) {
      display: block;
    }
    .stroke-canvas-fallback {
      font-size: 96px;
    }
    .stroke-tab {
      font-size: 10px;
      letter-spacing: 0.1em;
      min-height: 36px;
    }
    .ctrl-btn {
      font-size: 10px;
      padding: 6px 8px;
      min-height: 32px;
    }
    .stroke-char-label {
      font-size: 24px;
    }
    .nav-btn {
      padding: 6px 12px;
      font-size: 10px;
    }
    .char-pill {
      padding: 5px 12px;
      font-size: 16px;
    }
  }
</style>
