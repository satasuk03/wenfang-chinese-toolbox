---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Masthead from '../../../components/Masthead.astro';
import Footer from '../../../components/Footer.astro';

const examples = ['你好', '学海无涯', '今天', '中国'];
---

<BaseLayout title="Stroke order · Wénfáng">
  <Masthead />
  <main id="main">
    <section class="stroke">
      <div class="container">
        <header class="stroke-header">
          <p class="stroke-eyebrow">— Tool 02 · 笔顺</p>
          <h1>Stroke order.</h1>
          <p class="stroke-deck">
            Paste a Chinese character — or a whole phrase — and we play back the stroke order, one
            character at a time. Animations are served from
            <a
              href="https://www.strokeorder.com"
              target="_blank"
              rel="noopener noreferrer"
              class="link">strokeorder.com</a
            >.
          </p>
        </header>

        <form class="stroke-form" id="stroke-form" autocomplete="off">
          <label class="stroke-label" for="stroke-input">
            <span>—</span> Characters
          </label>
          <div class="stroke-input-row">
            <input
              type="text"
              id="stroke-input"
              class="stroke-input"
              placeholder="学海无涯"
              spellcheck="false"
              autocapitalize="off"
              maxlength="120"
            />
            <button type="submit" class="stroke-go">Show <span aria-hidden="true">→</span></button>
          </div>
          <div class="stroke-examples">
            <span class="stroke-examples-label">Try:</span>
            {
              examples.map((ex) => (
                <button type="button" class="stroke-example" data-example={ex}>
                  {ex}
                </button>
              ))
            }
          </div>
        </form>

        <div class="stroke-results" id="stroke-results" aria-live="polite"></div>

        <p class="stroke-empty" id="stroke-empty">
          Enter a character above to see its stroke order.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script is:inline>
  const form = document.getElementById('stroke-form');
  const input = document.getElementById('stroke-input');
  const results = document.getElementById('stroke-results');
  const emptyState = document.getElementById('stroke-empty');

  // Roughly: CJK Unified Ideographs + Extension A. We let strokeorder.com 404
  // tell us if a given codepoint isn't supported.
  const isHan = (cp) => {
    return (
      (cp >= 0x3400 && cp <= 0x4dbf) || // Ext A
      (cp >= 0x4e00 && cp <= 0x9fff) || // Main
      (cp >= 0x20000 && cp <= 0x2a6df) || // Ext B
      (cp >= 0x2a700 && cp <= 0x2b73f) || // Ext C
      (cp >= 0x2b740 && cp <= 0x2b81f) || // Ext D
      (cp >= 0x2b820 && cp <= 0x2ceaf) // Ext E
    );
  };

  const splitChars = (text) => {
    const out = [];
    for (const ch of text) {
      // ch is a code-point-aware iteration; ch.length may be 2 for surrogates
      const cp = ch.codePointAt(0);
      if (cp != null && isHan(cp)) out.push({ ch, cp });
    }
    return out;
  };

  const render = (chars) => {
    if (chars.length === 0) {
      results.innerHTML = '';
      emptyState.textContent = input.value
        ? 'No Chinese characters found in your input.'
        : 'Enter a character above to see its stroke order.';
      emptyState.style.display = 'block';
      return;
    }
    emptyState.style.display = 'none';
    results.innerHTML = chars
      .map(({ ch, cp }, i) => {
        const url = `https://www.strokeorder.com/assets/bishun/animation/${cp}.gif`;
        const hex = cp.toString(16).toUpperCase().padStart(4, '0');
        return `
          <figure class="stroke-card" data-status="loading">
            <div class="stroke-card-meta">
              <span>— ${String(i + 1).padStart(2, '0')}</span>
              <span>U+${hex}</span>
            </div>
            <div class="stroke-card-canvas">
              <img
                src="${url}"
                alt="Stroke order for ${ch}"
                loading="lazy"
                onload="this.closest('.stroke-card').dataset.status='ok'"
                onerror="this.closest('.stroke-card').dataset.status='missing'"
              />
              <div class="stroke-card-fallback" aria-hidden="true">${ch}</div>
              <div class="stroke-card-missing" aria-hidden="true">No stroke data</div>
            </div>
            <figcaption class="stroke-card-foot">
              <span class="stroke-card-char">${ch}</span>
              <span class="stroke-card-cp">${cp}</span>
            </figcaption>
          </figure>
        `;
      })
      .join('');
  };

  const submit = () => {
    const chars = splitChars(input.value);
    render(chars);
  };

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    submit();
  });

  document.querySelectorAll('.stroke-example').forEach((btn) => {
    btn.addEventListener('click', () => {
      input.value = btn.dataset.example || '';
      input.focus();
      submit();
    });
  });
</script>

<style>
  .stroke {
    padding: 80px 0 120px;
  }
  .stroke-header {
    max-width: 640px;
    margin-bottom: 56px;
  }
  .stroke-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 24px;
  }
  .stroke-header h1 {
    font-family: var(--font-display);
    font-size: clamp(48px, 5.4vw, 84px);
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    font-weight: 400;
    margin-bottom: 24px;
  }
  .stroke-deck {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-muted);
    text-wrap: pretty;
  }
  .stroke-deck .link {
    color: var(--color-fg);
    border-bottom: 1px solid var(--color-border);
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .stroke-deck .link:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  /* ─── Form ─── */
  .stroke-form {
    border-top: 1.5px solid var(--color-ink);
    padding-top: 28px;
    margin-bottom: 56px;
  }
  .stroke-label {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-fg);
    margin-bottom: 16px;
  }
  .stroke-label span {
    color: var(--color-accent);
  }
  .stroke-input-row {
    display: flex;
    gap: 12px;
    margin-bottom: 18px;
  }
  .stroke-input {
    flex: 1;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 18px 20px;
    font-family: var(--font-zh);
    font-size: 24px;
    color: var(--color-ink);
    letter-spacing: 0.04em;
    transition: border-color 0.15s ease;
    min-width: 0;
  }
  .stroke-input::placeholder {
    color: var(--color-soft);
    font-family: var(--font-zh);
  }
  .stroke-input:focus {
    outline: none;
    border-color: var(--color-ink);
  }
  .stroke-go {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--color-accent);
    color: var(--color-bg);
    border: 0;
    padding: 0 28px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background 0.15s ease,
      transform 0.15s ease;
    min-height: 56px;
  }
  .stroke-go:hover {
    background: var(--color-accent-deep);
  }
  .stroke-go:active {
    transform: translateY(1px);
  }
  .stroke-go span {
    transition: transform 0.15s ease;
  }
  .stroke-go:hover span {
    transform: translateX(4px);
  }

  .stroke-examples {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .stroke-examples-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-right: 6px;
  }
  .stroke-example {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 8px 14px;
    font-family: var(--font-zh);
    font-size: 16px;
    color: var(--color-ink);
    letter-spacing: 0.06em;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .stroke-example:hover {
    border-color: var(--color-ink);
    background: var(--color-paper);
  }

  /* ─── Empty state ─── */
  .stroke-empty {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 18px;
    color: var(--color-muted);
    text-align: center;
    padding: 48px 0;
    border-top: 1px solid var(--color-border);
  }

  /* ─── Results grid ─── */
  .stroke-results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }
  .stroke-results:empty {
    display: none;
  }

  .stroke-card {
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    padding: 16px 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: border-color 0.15s ease;
  }
  .stroke-card:hover {
    border-color: var(--color-ink);
  }
  .stroke-card-meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .stroke-card-canvas {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    overflow: hidden;
    /* mi-zi grid 米字格 */
    background-image:
      linear-gradient(
        to right,
        transparent calc(50% - 0.5px),
        oklch(60% 0.02 60 / 0.18) calc(50% - 0.5px),
        oklch(60% 0.02 60 / 0.18) calc(50% + 0.5px),
        transparent calc(50% + 0.5px)
      ),
      linear-gradient(
        to bottom,
        transparent calc(50% - 0.5px),
        oklch(60% 0.02 60 / 0.18) calc(50% - 0.5px),
        oklch(60% 0.02 60 / 0.18) calc(50% + 0.5px),
        transparent calc(50% + 0.5px)
      ),
      linear-gradient(
        45deg,
        transparent calc(50% - 0.5px),
        oklch(60% 0.02 60 / 0.12) calc(50% - 0.5px),
        oklch(60% 0.02 60 / 0.12) calc(50% + 0.5px),
        transparent calc(50% + 0.5px)
      ),
      linear-gradient(
        -45deg,
        transparent calc(50% - 0.5px),
        oklch(60% 0.02 60 / 0.12) calc(50% - 0.5px),
        oklch(60% 0.02 60 / 0.12) calc(50% + 0.5px),
        transparent calc(50% + 0.5px)
      );
  }
  .stroke-card-canvas img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.2s ease;
  }
  .stroke-card-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-zh);
    font-size: 96px;
    color: var(--color-soft);
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.2s ease;
  }
  .stroke-card-missing {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-align: center;
    padding: 16px;
  }

  /* States */
  .stroke-card[data-status='loading'] img {
    opacity: 0;
  }
  .stroke-card[data-status='ok'] img {
    opacity: 1;
  }
  .stroke-card[data-status='ok'] .stroke-card-fallback {
    opacity: 0;
  }
  .stroke-card[data-status='missing'] img {
    display: none;
  }
  .stroke-card[data-status='missing'] .stroke-card-fallback {
    display: none;
  }
  .stroke-card[data-status='missing'] .stroke-card-missing {
    display: flex;
  }

  .stroke-card-foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-top: 1px solid var(--color-border);
    padding-top: 10px;
  }
  .stroke-card-char {
    font-family: var(--font-zh);
    font-size: 20px;
    color: var(--color-ink);
    line-height: 1;
  }
  .stroke-card-cp {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.18em;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 880px) {
    .stroke {
      padding: 56px 0 80px;
    }
    .stroke-header {
      margin-bottom: 40px;
    }
    .stroke-input {
      font-size: 20px;
      padding: 14px 16px;
    }
    .stroke-go {
      padding: 0 18px;
      min-height: 50px;
    }
  }
  @media (max-width: 560px) {
    .stroke-input-row {
      flex-direction: column;
    }
    .stroke-go {
      width: 100%;
      justify-content: center;
      min-height: 48px;
      padding: 14px 18px;
    }
    .stroke-results {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .stroke-card {
      padding: 12px 12px 14px;
    }
    .stroke-card-fallback {
      font-size: 64px;
    }
  }
</style>
